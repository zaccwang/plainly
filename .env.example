# Firebase console > Project settings > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check > reCAPTCHA Enterprise site key (local dev uses a debug token instead)
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Optional: override cloud model
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
# Chrome Prompt API origin-trial token for your hosted domain (https://<project>.web.app).
# Register at https://developer.chrome.com/origintrials and paste the token here.
VITE_ORIGIN_TRIAL_TOKEN=
